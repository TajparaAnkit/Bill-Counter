rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Business profile: a user may only access their own (private) profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public storefront profile: anyone can read (for the shareable catalog),
    // but only the owner can write it. Holds only public-safe fields.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Products: PUBLICLY READABLE (powers the shareable catalog).
    // Writes remain restricted to the owner.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Bills: readable/writable only by their owner (identified by userId field).
    match /bills/{billId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
